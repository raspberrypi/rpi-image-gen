#!/bin/bash

set -eu

case ${IGconf_image_updatefmt} in
   none)
      ;;
   otamaker)
      outf="ota-${IGconf_image_name}-${IGconf_image_version}.tar.zst"

      cd "${1}"
      envsubst < "${IGconf_image_updatetpl}" > contents.yaml

      msg "Packing for OTA..."
      otamaker -w contents.yaml "${outf}"
      ;;
   *)
      die "unsupported update format: ${IGconf_image_updatefmt}"
      ;;
esac
