#!/bin/bash

set -eu

fs=$1
genimg_in=$2

[[ -d "$fs" ]] || exit 0


# Generate the persistent skeleton suitable for on-device overlay
tar --xattrs --xattrs-include='*' --acls --numeric-owner \
   -C "${fs}${IGconf_image_persistent_dir}" \
   -czf "${genimg_in}/persistent-skel.tar.gz" \
   --exclude='lost+found' .
