#!/bin/bash
#
# Compile the EarlyPersistFile= entries of every slot-shared.d file into one
# list, and enable saving the files back to persistent storage

set -eu

fs=$1

[[ -d "$fs" ]] || exit 0

list="${fs}/usr/lib/rpi-image-gen/early-persist-files"

shared=()
files=()
for conf in "${fs}/etc/rpi-image-gen/slot-shared.d/"*.conf; do
   [ -f "$conf" ] || continue
   while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|\#*) continue ;; esac
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
         Path)             shared+=("/${value#/}") ;;
         EarlyPersistFile) files+=("/${value#/}") ;;
      esac
   done < "$conf"
done

# The update stamp describes the files restored with it, so units with
# ConditionNeedsUpdate=/etc run once after a rotation to a newer /usr
files+=("/etc/.updated")

# The initrd restores files into an overlay on /etc. The rest of the root is
# read-only at that point, so nothing outside /etc can be restored from
# persistent storage.
for file in "${files[@]}"; do
   [[ $file =~ ^/etc(/[^/[:space:]]+)+$ && "${file}/" != */./* && "${file}/" != */../* ]] ||
      die "EarlyPersistFile=${file}: must be a file path under /etc"
   for path in "${shared[@]}"; do
      [[ $file == "${path%/}/"* ]] && die "EarlyPersistFile=${file}: inside shared Path=${path}"
   done
done

install -d -m 0755 "$(dirname "$list")"
printf '%s\n' "${files[@]}" | sed '/^$/d' | sort -u > "$list"
chmod 0644 "$list"

sysd="${fs}/etc/systemd/system"
[ -f "${sysd}/rpi-persist-files.service" ] || die "missing rpi-persist-files.service"
install -d -m 0755 "${sysd}/multi-user.target.wants"
ln -sf ../rpi-persist-files.service "${sysd}/multi-user.target.wants/rpi-persist-files.service"
