#!/bin/bash

set -eu

fs=$1
genimg_in=$2

[[ -d "$fs" ]] || exit 0

perst="${fs}${IGconf_image_persistent_dir}"


# Create persistent skeleton - must match part names in genimage.cfg.in
mkdir -p ${perst}/slots/system_a/var
mkdir -p ${perst}/slots/system_b/var

install -d -m 1777 ${perst}/slots/system_a/var/tmp
install -d -m 1777 ${perst}/slots/system_b/var/tmp


# machine-id(5): ship an empty file, add entry for legacy dbus
rm -f "${fs}/etc/machine-id"
rm -f "${fs}/var/lib/dbus/machine-id"
install -m0644 -o root -g root /dev/null "${fs}/etc/machine-id"
install -d -m 0755 "${fs}/var/lib/dbus/"
ln -s /etc/machine-id "${fs}/var/lib/dbus/machine-id"


# persistent-shared-init needed by local-fs.target
wants_dir="${fs}/etc/systemd/system/local-fs.target.wants"
units=(
  "persistent-shared-init.service"
)
install -d -m 0755 "${wants_dir}"
for unit in "${units[@]}"; do
  [ -f "${fs}/etc/systemd/system/${unit}" ] || die "missing ${unit}"
  chmod 0644 "${fs}/etc/systemd/system/${unit}"
  ln -sf "../${unit}" "${wants_dir}/${unit}"
done


# Save the EarlyPersistFile= paths back to persistent storage
sysd="${fs}/etc/systemd/system"
[ -f "${sysd}/rpi-persist-files.service" ] || die "missing rpi-persist-files.service"
install -d -m 0755 "${sysd}/multi-user.target.wants"
ln -sf ../rpi-persist-files.service "${sysd}/multi-user.target.wants/rpi-persist-files.service"


# /home and the journal bind mounts required by local-fs.target
requires_dir="${fs}/etc/systemd/system/local-fs.target.requires"
units=(
  "home.mount"
  "var-log-journal.mount"
)
install -d -m 0755 "${requires_dir}"
for unit in "${units[@]}"; do
  [ -f "${fs}/etc/systemd/system/${unit}" ] || die "missing ${unit}"
  chmod 0644 "${fs}/etc/systemd/system/${unit}"
  ln -sf "../${unit}" "${requires_dir}/${unit}"
done


# The image's /var, kept in the image. A slot's /var is reset from it on its
# first boot after an update, see slot-var-reset. The directories in cache,
# log and tmp are kept, but not the files.
factory="${fs}/usr/share/factory/var"
mkdir -p "$factory"
rsync -aHAXS --numeric-ids --delete \
   --include='/cache/**/' --include='/log/**/' --include='/tmp/**/' \
   --exclude='/cache/**' --exclude='/log/**' --exclude='/tmp/**' \
   "${fs}/var/" "${factory}/"

# /var is per-slot, and starts as the factory copy
rsync -aHAXS --numeric-ids --delete "${factory}/" "${perst}/slots/system_a/var/"
rsync -aHAXS --numeric-ids --delete "${factory}/" "${perst}/slots/system_b/var/"


# Journal is retained across slot rotations
# set preferences
# https://www.freedesktop.org/software/systemd/man/latest/journald.conf.html
install -d -m 0755 ${fs}/etc/systemd/journald.conf.d
cat > ${fs}/etc/systemd/journald.conf.d/persistent.conf <<'EOF'
[Journal]
Storage=persistent

# Reduce space
Compress=yes

# Lower disk budget
SystemMaxUse=512M
SystemMaxFileSize=20M

# No time window retention
MaxRetentionSec=0
MaxFileSec=0

# Endurance profile
RuntimeMaxUse=128M
SyncIntervalSec=2m
RateLimitInterval=30s
RateLimitBurst=2000

# Integrity
Seal=yes
EOF


# /home is bind mounted to the persistent home and retained across slot rotations
# Mirror it
mkdir -p "${perst}/home/"
rsync -aHAXS --numeric-ids --delete "${fs}/home/" "${perst}/home/"

# Reclaim /home
find "${fs}/home" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +


# Reclaim /var but ensure skeleton exists for services that need PrivateTmp
# otherwise namespace setup will fail on the immutable root.
find "${fs}/var" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
install -d -m 1777 ${fs}/var/tmp
install -d -m 0755 ${fs}/var/log
install -d -m 0755 ${fs}/var/cache
install -d -m 0755 ${fs}/var/spool



# Perms for bind mounts on the immutable root
chmod 755 "${fs}/home"
chmod 755 "${fs}/var"
