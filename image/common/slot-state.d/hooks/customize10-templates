#!/bin/bash
#
# Render this layer's templates into its generated overlay

set -eu

tpl="${LAYER_DOTD}/templates"
out="${LAYER_WORKDIR}/customize.overlay"

find "$tpl" -type f -printf '%P\0' | while IFS= read -r -d '' f; do
   install -D -m "$(stat -c %a "${tpl}/${f}")" /dev/null "${out}/${f}"
   sed "s|<PERSISTENT_DIR>|${IGconf_image_persistent_dir}|g" "${tpl}/${f}" > "${out}/${f}"
done
