[Unit]
Description=Journal retained across slot rotations
RequiresMountsFor=<PERSISTENT_DIR>/log/journal
Wants=persistent-shared-init.service
After=persistent-shared-init.service
Before=local-fs.target

[Mount]
What=<PERSISTENT_DIR>/log/journal
Where=/var/log/journal
Type=none
Options=bind,slave,shared

[Install]
RequiredBy=local-fs.target
