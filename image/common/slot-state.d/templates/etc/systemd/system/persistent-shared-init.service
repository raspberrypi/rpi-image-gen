[Unit]
Description=Initialise the persistent partition
# TODO: if/when a top level persistent-ready.target is introduced, replace the
# direct persistent mount dependency below with After=persistent-ready.target,
# and add health-check service before it.
DefaultDependencies=no
RequiresMountsFor=<PERSISTENT_DIR>
Before=local-fs.target
Before=var.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-tmpfiles --remove --create /usr/lib/rpi-image-gen/slot-state.tmpfiles
