[Unit]
Description=Sync machine-id to/from persistent storage
DefaultDependencies=no
Before=systemd-journald.service sysinit.target
ConditionPathExists=<PERSISTENT_DIR>/common/etc
RequiresMountsFor=<PERSISTENT_DIR>/common/etc/machine-id

[Service]
Type=oneshot
ExecStart=/bin/sh -eu -c 'P=<PERSISTENT_DIR>/common/etc/machine-id; R=/run/machine-id; if [ -s "$P" ]; then cat "$P" > "$R"; else /usr/bin/install -m0644 "$R" "$P"; fi'

[Install]
WantedBy=sysinit.target
