#!/bin/sh
# systemd generator to bind per-slot /var from the persistent partition

set -eu

OUT_DIR="/run/systemd/generator"
mkdir -p "$OUT_DIR"

# 1) Determine current slot
SLOT=""
ROOT_DEV="$(findmnt -no SOURCE / || true)"
if [ -n "$ROOT_DEV" ]; then
  PARTLABEL="$(blkid -s PARTLABEL -o value -- "$ROOT_DEV" 2>/dev/null || true)"
  case "$(printf '%s' "$PARTLABEL" | tr '[:upper:]' '[:lower:]')" in
    system_a) SLOT="system_a" ;;
    system_b) SLOT="system_b" ;;
  esac
fi

# Optional fallback if label is missing/unexpected
: "${SLOT:=${SLOT_FALLBACK:-system_a}}"

VAR_SRC="<PERSISTENT_DIR>/slots/${SLOT}/var"

# 2) Emit slot-var-reset.service (reset the slot's /var from the image after
# an update, before it is mounted). ConditionNeedsUpdate= is documented for
# /etc and /var, but systemd applies the same check to any absolute path.
cat >"$OUT_DIR/slot-var-reset.service" <<EOF
[Unit]
Description=Reset /var for ${SLOT} from the image
DefaultDependencies=no
RequiresMountsFor=${VAR_SRC}
ConditionNeedsUpdate=${VAR_SRC}
Before=var.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/slot-var-reset ${VAR_SRC}
EOF

# 3) Emit var.mount (bind per-slot /var)
cat >"$OUT_DIR/var.mount" <<EOF
[Unit]
Description=Per-slot /var for ${SLOT}
RequiresMountsFor=${VAR_SRC}
Wants=slot-var-reset.service
After=slot-var-reset.service
Before=local-fs.target
ConditionPathExists=${VAR_SRC}

[Mount]
What=${VAR_SRC}
Where=/var
Type=none
Options=bind,slave,shared

[Install]
WantedBy=local-fs.target
EOF
