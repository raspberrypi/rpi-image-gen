#!/usr/bin/env python3
#
# slot-state-manifest compile <persistent-dir> <rootfs>
#    Compile every slot-shared.d declaration in <rootfs> into one manifest,
#    the only thing read on the device, the systemd-tmpfiles file that lays
#    down the persistent partition from it, and the path unit that watches
#    the EarlyPersistFile= entries for changes.
#
# slot-state-manifest doc <file>
#    Write the reference for the keys below into <file>, between the
#    DOC_BEGIN and DOC_END lines.
#
# Each key declares a VFS operation (vfsop) on a path.
#
# The manifest has one entry per line, '-' where a field does not apply:
#
#    op path store seed bind
#
# Entries are sorted so they can be processed in order: EarlyPersistFile,
# then StaticPath (removed before anything is seeded), then SharedPath, parents
# before children.

import os
import re
import sys
from pathlib import Path


# The vfsops of a Version=1 declaration, each named by its key, and their
# reference
VERSION_DOC = (
    "Required. The format of the file. Any other value fails the build.")

KEYS_V1 = {
    "SharedPath": (
        "A directory shared across slots. `{persistent_dir}/shared/<path>` is bind-mounted over "
        "it, so every slot reads and writes the same data. Before the bind, files from the image "
        "that are missing there are copied in. Existing files are never overwritten, so changes "
        "made at runtime are kept. It must exist as a directory in the image. `SharedPath=` "
        "directories may be nested."),
    "StaticPath": (
        "A file or directory inside a `SharedPath=` directory that the image owns rather than the "
        "device. The `SharedPath=` may be declared by any file. It is replaced from the active slot "
        "on every boot, so it always matches the running image, and anything written to it at "
        "runtime is discarded. If the image does not contain it, it is removed from the shared "
        "location."),
    "EarlyPersistFile": (
        "A single file under `/etc` kept in `{persistent_dir}/common` across boots and slot "
        "rotations, and in place before switch-root. A stored copy takes precedence over the "
        "image's file. Changes made on the device are saved back, see <<early-persist-files>>."),
}

# Other names a key is accepted under
ALIASES_V1 = {"Path": "SharedPath"}

RULES_DOC = (
    "Each key may appear any number of times. Paths are absolute: a missing leading `/`, a "
    "trailing `/` and repeated `/` are corrected. A path must not contain whitespace, `%`, "
    "`.` or `..`, must not pass through a symlink in the image, and must not overlap the persistent "
    "directory. A path declared more than once with the same vfsop, by any files, is one entry. "
    "Declaring it with different vfsops, or using an unknown key, fails the build.")

# The account files, which are only consistent with each other
ACCOUNT_FILES = ["/etc/passwd", "/etc/shadow", "/etc/group", "/etc/gshadow"]

# The order vfsops are applied in, whatever their order in a file
ORDER = ["EarlyPersistFile", "StaticPath", "SharedPath"]

DOC_BEGIN = "// BEGIN generated by slot-state.d/self/host/bin/slot-state-manifest doc"
DOC_END = "// END generated"


def write_doc(file):
    ref = ["Each key other than `Version=` declares a VFS operation (vfsop) on a path.", ""]
    ref += [f"`Version=1`:: {VERSION_DOC}"]
    for key, doc in KEYS_V1.items():
        ref += [f"`{key}=`:: {doc}"]
        ref += [f"`{a}=`:: The original name of `{key}=`, still accepted."
                for a, k in ALIASES_V1.items() if k == key]
    ref += ["", RULES_DOC]
    ref += ["", "VFS operations are applied in a fixed order, whatever their order in a file: "
            + ", then ".join(f"`{op}=`" for op in ORDER)
            + ". Within each, paths are applied parents first."]
    text = Path(file).read_text()
    begin, end = text.index(DOC_BEGIN) + len(DOC_BEGIN), text.index(DOC_END)
    Path(file).write_text(text[:begin] + "\n" + "\n".join(ref) + "\n" + text[end:])


if sys.argv[1:2] == ["doc"] and len(sys.argv) == 3:
    write_doc(sys.argv[2])
    sys.exit(0)

if sys.argv[1:2] != ["compile"] or len(sys.argv) != 4:
    sys.exit("usage: slot-state-manifest compile <persistent-dir> <rootfs>\n"
             "       slot-state-manifest doc <file>")

perst, fs = sys.argv[2], Path(sys.argv[3])
confdir = fs / "etc/rpi-image-gen/slot-shared.d"
manifest = fs / "usr/lib/rpi-image-gen/slot-state.manifest"
tmpfiles = fs / "usr/lib/rpi-image-gen/slot-state.tmpfiles"
pathunit = fs / "etc/systemd/system/rpi-persist-files-changed.path"

# The persistent partition's own directories, as (path, mode, user, group)
SKELETON = [
    ("common/etc", "0755", "root", "root"),
    ("log/journal", "2755", "root", "systemd-journal"),
]


def fail(msg):
    sys.exit(f"slot-state manifest: {msg}")


def inside(path, parent):
    return path.startswith(parent + "/")


# Leading, trailing and repeated slashes are corrected. Anything else that is
# not a plain absolute path is rejected.
def normalise(value):
    parts = [p for p in value.split("/") if p]
    if not parts or any(p in (".", "..") or re.search(r"\s", p) for p in parts):
        return None
    return "/" + "/".join(parts)


# Version=1 declarations, as [(key, op, path)]
def parse_v1(conf, pairs):
    entries = []
    for key, value in pairs:
        if key == "Version":
            continue
        op = ALIASES_V1.get(key, key)
        if op not in KEYS_V1:
            fail(f"{conf}: unknown key {key}")
        path = normalise(value)
        if not path:
            fail(f"{conf}: {key}={value}: not an absolute path")
        if "%" in path:
            # systemd-tmpfiles reads % as a specifier
            fail(f"{conf}: {key}={value}: must not contain %")
        entries.append((key, op, path))
    return entries


PARSERS = {"1": parse_v1}


# Declarations from every file, as {path: (op, conf, key)}. The update stamp
# describes the files kept with it, see preimage10-update-done.
decl = {"/etc/.updated": ("EarlyPersistFile", "slot-state", "EarlyPersistFile")}

for conf in sorted(confdir.glob("*.conf")):
    pairs = []
    for line in conf.read_text().splitlines():
        if line and not line.startswith("#"):
            key, _, value = line.partition("=")
            pairs.append((key, value))
    version = dict(pairs).get("Version")
    if version not in PARSERS:
        fail(f"{conf.name}: unsupported Version={version or '(missing)'}")
    for key, op, path in PARSERS[version](conf.name, pairs):
        if decl.setdefault(path, (op, conf.name, key))[0] != op:
            fail(f"{conf.name}: {key}={path}: also declared by {decl[path][1]} as {decl[path][2]}=")

# Persisting some account files and not others leaves them out of step
persisted = [p for p in ACCOUNT_FILES if decl.get(p, ("",))[0] == "EarlyPersistFile"]
if persisted and len(persisted) != len(ACCOUNT_FILES):
    missing = ", ".join(p for p in ACCOUNT_FILES if p not in persisted)
    fail(f"EarlyPersistFile={persisted[0]}: also needs EarlyPersistFile= for {missing}")

shared = sorted(p for p, (o, _, _) in decl.items() if o == "SharedPath")


for path, (op, conf, key) in decl.items():
    what = f"{conf}: {key}={path}"
    within = [p for p in shared if inside(path, p)]

    parts = path.split("/")[1:]
    for i in range(len(parts)):
        link = fs.joinpath(*parts[:i + 1])
        if not link.is_symlink():
            continue
        if op == "EarlyPersistFile" and i == len(parts) - 1:
            target = os.path.normpath(os.path.join(os.path.dirname(path), os.readlink(link)))
            if inside(target, "/etc"):
                fail(f"{what}: is a symlink to {target}, declare that instead")
            fail(f"{what}: is a symlink to {target}, outside /etc")
        fail(f"{what}: /{'/'.join(parts[:i + 1])} is a symlink in the image")

    if path == perst or inside(path, perst) or inside(perst, path):
        fail(f"{what}: overlaps the persistent directory {perst}")

    if op == "SharedPath" and not fs.joinpath(*parts).is_dir():
        fail(f"{what}: not a directory in the image")
    if op == "StaticPath" and not within:
        fail(f"{what}: not inside a SharedPath=")
    if op == "EarlyPersistFile" and within:
        fail(f"{what}: inside SharedPath={within[0]}")
    if op == "EarlyPersistFile" and not inside(path, "/etc"):
        # The initrd restores files into an overlay on /etc. The rest of the
        # root is read-only at that point.
        fail(f"{what}: must be under /etc")


# Where each entry is kept on the persistent partition. A StaticPath is kept
# inside the store of the nearest SharedPath enclosing it.
def store(path, op):
    if op == "EarlyPersistFile":
        return f"{perst}/common{path}"
    if op == "SharedPath":
        return f"{perst}/shared{path}"
    parent = max(p for p in shared if inside(path, p))
    return store(parent, "SharedPath") + path.removeprefix(parent)


# Where an entry's content comes from in the image. /var is emptied in the
# image, and kept in its factory copy.
def factory(path):
    return f"/usr/share/factory{path}" if inside(path, "/var") else path


entries = sorted(decl.items(), key=lambda e: (ORDER.index(e[1][0]), e[0].split("/")))

manifest.parent.mkdir(parents=True, exist_ok=True)
with manifest.open("w") as f:
    f.write("# op path store seed bind\n")
    for path, (op, _, _) in entries:
        seed = "-" if op == "EarlyPersistFile" else factory(path)
        bind = "optional" if op == "SharedPath" else "-"
        f.write(f"{op} {path} {store(path, op)} {seed} {bind}\n")
manifest.chmod(0o644)

# Applied with systemd-tmpfiles --remove --create, which removes every R before
# it copies anything. Not in tmpfiles.d: applied again after the binds, the R
# lines would remove files in use.
with tmpfiles.open("w") as f:
    f.write("# Generated by slot-state-manifest\n")
    for sub, mode, user, group in SKELETON:
        f.write(f"d {perst}/{sub} {mode} {user} {group} -\n")
    # C copies only when the destination is missing or empty
    f.write(f"C {perst}/home - - - - /usr/share/factory/home\n")
    for path, (op, _, _) in entries:
        if op == "StaticPath":
            f.write(f"# {op} {path}\nR {store(path, op)}\n")
        if op == "SharedPath":
            f.write(f"# {op} {path}\nC+ {store(path, op)} - - - - {factory(path)}\n")
tmpfiles.chmod(0o644)

# Starts rpi-persist-files-changed.service whenever an EarlyPersistFile=
# changes
pathunit.parent.mkdir(parents=True, exist_ok=True)
with pathunit.open("w") as f:
    f.write("# Generated by slot-state-manifest\n"
            "[Unit]\nDescription=Watch persisted files for changes\n"
            "ConditionPathIsMountPoint=/etc\n\n[Path]\n")
    for path, (op, _, _) in entries:
        if op == "EarlyPersistFile":
            f.write(f"PathChanged={path}\n")
    f.write("\n[Install]\nWantedBy=paths.target\n")
pathunit.chmod(0o644)
