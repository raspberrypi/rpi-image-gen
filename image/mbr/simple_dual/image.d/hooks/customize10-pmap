#!/bin/sh

set -eu

# Generate pre-defined UUIDs
BOOT_LABEL=$(uuidgen | sed 's/-.*//' | tr 'a-f' 'A-F')
BOOT_UUID=$(echo "$BOOT_LABEL" | sed 's/^\(....\)\(....\)$/\1-\2/')
ROOT_UUID=$(uuidgen)
CRYPT_UUID=$(uuidgen)

rm -f ${IGconf_image_outputdir}/img_uuids
for v in BOOT_LABEL BOOT_UUID ROOT_UUID CRYPT_UUID; do
    eval "val=\$$v"
    echo "$v=$val" >> "${IGconf_image_outputdir}/img_uuids"
done

# Optional LUKS2 attributes are substituted as a whole member, or nothing
LUKS_SECTOR_SIZE_ATTR=
if [ -n "${IGconf_device_luks2_sector_size:-}" ]; then
   LUKS_SECTOR_SIZE_ATTR="\"sector_size\": ${IGconf_device_luks2_sector_size},"
fi

# Install provision map, populating placeholders
pmap="../device/provisionmap-${IGconf_image_pmap:-}.json"
if [ -f "$pmap" ]; then
   env \
      CRYPT_UUID="$CRYPT_UUID" \
      LUKS_CIPHER="$IGconf_device_luks2_cipher" \
      LUKS_KEYSIZE="$IGconf_device_luks2_keysize" \
      LUKS_HASH="$IGconf_device_luks2_hash" \
      LUKS_SECTOR_SIZE_ATTR="$LUKS_SECTOR_SIZE_ATTR" \
   envsubst \
      '${CRYPT_UUID} ${LUKS_CIPHER} ${LUKS_KEYSIZE} ${LUKS_HASH} ${LUKS_SECTOR_SIZE_ATTR}' \
      < "$pmap" > "${IGconf_image_outputdir}/provisionmap.json"
fi
