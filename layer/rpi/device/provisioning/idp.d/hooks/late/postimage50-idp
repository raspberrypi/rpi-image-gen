#!/bin/bash
#
# IDP doc generation

set -eu

igconf isy image_idp_enable || exit 0

opts=()
pmap_installed=false

pmap="${IGconf_image_outputdir}/provisionmap.json"

# Validate an installed Provisioning Map against its schema
if [ -f "$pmap" ] ; then
   pmap --schema "$IGconf_image_pmap_schema" --file "$pmap" ||
      die "IDP: Installed Provisioning Map failed validation."
   pmap_installed=true
   opts+=('-m' "$pmap")
else
   warn "IDP: No Provisioning Map installed. Raspberry Pi provisioning flow unsupported."
fi

# Only genimage output is supported for IDP flow
if [ "${IGconf_image_provider:-}" = "genimage" ] && [ -f ${1}/genimage.cfg ] ; then
   # Sections the IDP schema marks as taking drop-ins
   mapfile -t sections < <(python3 -c '
import json, sys
for key, value in json.load(open(sys.argv[1])).get("properties", {}).items():
    if isinstance(value, dict) and value.get("x-dropin") is True:
        print(key)
' "$IGconf_image_idp_schema")

   # A fragment replaces an earlier layer's fragment of the same name, in its
   # place. An empty fragment removes it.
   add_fragment() {
      local frag=$1 layer=$2 name=${1##*/}

      if [[ -n ${frags[$name]+x} ]]; then
         msg "IDP: ${section}: ${name}: ${frags[$name]} replaced by ${frag} (${layer})"
      else
         names+=("$name")
      fi
      frags[$name]=$frag
   }

   # The remaining fragments are merged by image2json in this order
   for section in "${sections[@]}"; do
      names=()
      declare -A frags=()
      foreach_dropin "$LAYER_NAME" "$LAYER_VERSION" "$section" add_fragment
      for name in "${names[@]}"; do
         if [[ -s ${frags[$name]} ]]; then
            opts+=('--section' "$section" "${frags[$name]}")
         fi
      done
   done

   image2json -g ${1}/genimage.cfg "${opts[@]}" > ${1}/image.json ||
      die "IDP: Doc generation failed."

   # Validate IDP doc against IDP schema
   pmap --schema "$IGconf_image_idp_schema" --file "${1}/image.json" ||
      die "IDP: Image Description Provisioning doc failed validation."

   # Validate spliced PMAP within the IDP doc against the PMAP schema
   if $pmap_installed ; then
      pmap --schema "$IGconf_image_pmap_schema" --file "${1}/image.json" ||
         die "IDP: Merged PMAP failed validation."
   fi
fi

msg "IDP: Description written to ${1}/image.json"
