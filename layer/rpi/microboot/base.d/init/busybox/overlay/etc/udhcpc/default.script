#!/bin/sh
# udhcpc default.script - called by udhcpc on DHCP events
case "$1" in
  deconfig)
    ifconfig "$interface" 0.0.0.0
    ;;
  bound|renew)
    ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}" ${broadcast:+broadcast "$broadcast"}

    if [ -n "$router" ]; then
      while route del default gw 0.0.0.0 dev "$interface" 2>/dev/null; do :; done
      for gw in $router; do
        route add default gw "$gw" dev "$interface"
      done
    fi

    if [ -n "$dns" ]; then
      : > /etc/resolv.conf
      for ns in $dns; do
        echo "nameserver $ns" >> /etc/resolv.conf
      done
    fi

    killall ntpd 2>/dev/null || true
    ntpd -s >/dev/null &
    ;;
esac
