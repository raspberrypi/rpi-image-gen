#!/bin/bash

set -u

source "${IGTOP}/lib/common.sh"

add_dir() {
   local spec=$1 dir
   if dir=$(map_path "$spec") && [[ -d $dir ]]; then
      dirs+=("$dir")
   fi
}

PHASE="$1"
PLAN="$2"
shift 2


# The phase name is the only key runner works from - it is the prefix every
# hook and overlay is discovered by. A layer's own are found by walking the
# build plan and looking under that layer's <stem>.d. Hooks belonging to no
# layer live in these directories, scanned in this order and executed after
# all layers.
dirs=()
add_dir 'SRCROOT:hooks'          # source tree hooks
add_dir 'IGROOT:builtin/hooks'   # built-in hooks


# Source tree overlays, applied once at the given phase after every layer's
# own content
declare -A TREE_OVERLAYS=(
   [customize]="\
SRCROOT:rootfs-overlay"
)


# Extra positional args a phase hands to everything it runs. The first is the
# directory the phase operates on, and so the overlay destination.
phase_args() {
   local phase=$1
   shift || true

   case $phase in
      postbuild)
         set -- "$@" "${IGconf_target_path:?"required for $phase"}"
         ;;
      preimage)
         set -- "$@" "${IGconf_target_path:?"required for $phase"}"
         set -- "$@" "${IGconf_image_outputdir:?"required for $phase"}"
         ;;
      postimage)
         set -- "$@" "${IGconf_image_outputdir:?"required for $phase"}"
         ;;
      sbom)
         set -- "$@" "${IGconf_target_path:?"required for $phase"}"
         set -- "$@" "${IGconf_target_dir:?"required for $phase"}"
         ;;
      deploy)
         [[ -n ${IGconf_deploy_dir:-} ]] && set -- "$@" "$IGconf_deploy_dir"
         ;;
      *)
   esac
   # No output at all when the phase adds nothing, otherwise a lone format
   # pass would emit one empty argument
   [[ $# -eq 0 ]] || printf '%s\0' "$@"
}


# Run one hook from its own directory. An env file, when non-empty and present,
# is supported.
runhook() {
   local envfile=$1 path=$2; shift 2 || true
   local dir=$(dirname "$path")
   local name=$(basename "$path")

   if [[ ! -x $path ]]; then
      warn "runner: $dir [ignored, non-executable $name]"
      return 0
   fi

   msg "runner: $dir [run $name] [args $@]"
   if [[ -n $envfile && -f $envfile ]]; then
      runenv "$envfile" -C "$dir" "./$name" "$@"
   else
      env -C "$dir" "./$name" "$@"
   fi
   local rc=$?
   [[ $rc -eq 0 ]] || die "runner: $dir/$name ($rc)"
}


# rsync an overlay directory over a destination
apply_overlay() {
   local src=$1 dest=$2

   [[ -d $src && -n $dest && -d $dest ]] || return 0

   msg "runner: overlay [$src -> $dest]"
   rsync -a --chmod=go-w --exclude='.keep' --exclude='.empty' -- "$src/" "$dest/"
   local rc=$?
   [[ $rc -eq 0 ]] || die "runner: error applying overlay ($rc)"
}


# Run every <phase>* script in a directory, lexicographic order. Subdirectories
# are not traversed and the file extension is ignored.
run_dir_hooks() {
   local dir=$1 phase=$2 envfile=$3; shift 3 || true

   [[ -d $dir ]] || return 0
   compgen -G "${dir}/${phase}"* >/dev/null || return 0

   local script name stem
   for script in "${dir}/${phase}"*; do
      [[ -f $script ]] || continue   # subdirectories are not traversed
      name=$(basename "$script")
      stem="${name%%.*}"
      if [[ $stem =~ ^[a-zA-Z0-9-]+$ ]]; then
         runhook "$envfile" "$script" "$@"
      else
         warn "runner: $dir [skipped $name]"
      fi
   done
}


# Per-layer phased execution
_run_layer_step() {
   local layer=$1 version=$2 stem=$3 phase=$4; shift 4
   local dest=${1:-}
   local ldir vmajor vminor vpatch

   # customize is the only phase runner does not apply an overlay for: those
   # are applied by the layer's synthesised pre-config so that a layer's
   # overlay lands ahead of its own customize-hooks
   [[ $phase == customize ]] || apply_overlay "${stem}.d/${phase}.overlay" "$dest"

   # Hooks run from their own directory, so a layer's must be told where the
   # layer itself lives to reach anything else it ships
   ldir=$(dirname "$stem")
   IFS='.' read -r vmajor vminor vpatch <<< "$version"

   LAYER_NAME=$layer LAYER_VERSION=$version LAYER_DIR=$ldir \
   LAYER_VERSION_MAJOR=$vmajor LAYER_VERSION_MINOR=$vminor \
   LAYER_VERSION_PATCH=$vpatch \
   run_dir_hooks "${stem}.d/hooks" "$phase" "${stem}.d/env" "$@"
}


# Everything that happens in a phase, in order. Each step is skipped when the
# phase has nothing for it, so no phase needs special-casing. $1 is the
# directory the phase operates on, and so the overlay destination.
run_phase() {
   local phase=$1; shift || true
   local dest=${1:-}

   # Layers in build plan order. A layer's overlay is applied before that same
   # layer's hooks, so its hooks may rely on its own overlay content.
   plan_foreach _run_layer_step "$phase" "$@"

   # Source tree overlays, after every layer's own content
   local spec src
   for spec in ${TREE_OVERLAYS[$phase]:-}; do
      src=$(map_path "$spec") && apply_overlay "$src" "$dest"
   done

   # Hooks belonging to no layer
   local dir
   for dir in "${dirs[@]}"; do
      run_dir_hooks "$dir" "$phase" "${dir}/env" "$@"
   done
}


args=()
while IFS= read -r -d '' arg ; do
   args+=("$arg")
done < <(phase_args "$PHASE")
args+=("$@")

msg "runner: in $PHASE"
run_phase "$PHASE" "${args[@]}"
msg "runner: out $PHASE"
