#!/bin/bash

set -eu

# Remove the apt proxy if it was added
if [ -s $1/etc/apt/apt.conf.d/99mmdebstrap ] ; then
   if [[ ! -z ${IGconf_sys_apt_proxy_http+z} ]] ; then
      sed -i "\|Acquire\:\:http.*$IGconf_sys_apt_proxy_http|d" $1/etc/apt/apt.conf.d/99mmdebstrap
   fi
fi

# Write issue info
build_id=$(< "${IGconf_target_dir}/BUILD_ID")
ig_ver=$(cat "${IGTOP}/VERSION" 2> /dev/null || \
   git -C "$IGTOP" describe --tags --always --dirty 2> /dev/null || \
   echo "unknown")

mkdir -p "$1/etc"
echo "Generated using rpi-image-gen ${ig_ver} on $(date -u -d "@${SOURCE_DATE_EPOCH}" +%Y-%m-%d)" > "$1/etc/rpi-issue"
echo "Artefact version: $IGconf_artefact_version" >> "$1/etc/rpi-issue"

# See os-release(5)
if [ -e "$1/etc/os-release" ]; then
   {
      [ -z "${IGconf_image_name:-}" ] || echo "IMAGE_ID=\"$IGconf_image_name\""
      echo "BUILD_ID=\"$build_id\""
      echo "IMAGE_VERSION=\"$IGconf_artefact_version\""
      echo "IG_SOURCE_DATE_EPOCH=\"${SOURCE_DATE_EPOCH}\""
   } | tee -a "$1/etc/os-release"
fi
